{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/nlsc-wfs/:path*",      "destination": "/api/proxy?__route=nlsc-wfs&__path=:path*" },
    { "source": "/nlsc-wfs",             "destination": "/api/proxy?__route=nlsc-wfs" },
    { "source": "/nlsc-wmts/:path*",     "destination": "/api/proxy?__route=nlsc-wmts&__path=:path*" },
    { "source": "/nlsc-wmts",            "destination": "/api/proxy?__route=nlsc-wmts" },
    { "source": "/nlsc-wms/:path*",      "destination": "/api/proxy?__route=nlsc-wms&__path=:path*" },
    { "source": "/nlsc-wms",             "destination": "/api/proxy?__route=nlsc-wms" },
    { "source": "/nlsc-api/:path*",      "destination": "/api/proxy?__route=nlsc-api&__path=:path*" },
    { "source": "/nlsc-api",             "destination": "/api/proxy?__route=nlsc-api" },
    { "source": "/cgs-wms/:path*",       "destination": "/api/proxy?__route=cgs-wms&__path=:path*" },
    { "source": "/cgs-wms",              "destination": "/api/proxy?__route=cgs-wms" },
    { "source": "/swcb-wms/:path*",      "destination": "/api/proxy?__route=swcb-wms&__path=:path*" },
    { "source": "/swcb-wms",             "destination": "/api/proxy?__route=swcb-wms" },
    { "source": "/soil-wms/:path*",      "destination": "/api/proxy?__route=soil-wms&__path=:path*" },
    { "source": "/soil-wms",             "destination": "/api/proxy?__route=soil-wms" },
    { "source": "/moenv-wms/:path*",     "destination": "/api/proxy?__route=moenv-wms&__path=:path*" },
    { "source": "/moenv-wms",            "destination": "/api/proxy?__route=moenv-wms" },
    { "source": "/ncdr-wms/:path*",      "destination": "/api/proxy?__route=ncdr-wms&__path=:path*" },
    { "source": "/ncdr-wms",             "destination": "/api/proxy?__route=ncdr-wms" },
    { "source": "/pvgis/:path*",         "destination": "/api/proxy?__route=pvgis&__path=:path*" },
    { "source": "/pvgis",                "destination": "/api/proxy?__route=pvgis" },
    { "source": "/open-elevation/:path*","destination": "/api/proxy?__route=open-elevation&__path=:path*" },
    { "source": "/open-elevation",       "destination": "/api/proxy?__route=open-elevation" },
    { "source": "/tpe-tree/:path*",       "destination": "/api/proxy?__route=tpe-tree&__path=:path*" },
    { "source": "/tpe-tree",              "destination": "/api/proxy?__route=tpe-tree" },
    { "source": "/cwa-api/:path*",        "destination": "/api/proxy?__route=cwa-api&__path=:path*" },
    { "source": "/cwa-api",               "destination": "/api/proxy?__route=cwa-api" },
    { "source": "/epa-api/:path*",        "destination": "/api/proxy?__route=epa-api&__path=:path*" },
    { "source": "/epa-api",               "destination": "/api/proxy?__route=epa-api" },
    { "source": "/tdx-auth/:path*",       "destination": "/api/proxy?__route=tdx-auth&__path=:path*" },
    { "source": "/tdx-auth",              "destination": "/api/proxy?__route=tdx-auth" },
    { "source": "/tdx-api/:path*",        "destination": "/api/proxy?__route=tdx-api&__path=:path*" },
    { "source": "/tdx-api",               "destination": "/api/proxy?__route=tdx-api" }
  ]
}
